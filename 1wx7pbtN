import pandas as pd
import numpy as np
import warnings
import optuna

from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import mean_absolute_error
from sklearn.linear_model import LogisticRegression

from catboost import CatBoostClassifier
from xgboost import XGBClassifier
from lightgbm import LGBMClassifier

warnings.filterwarnings('ignore')

# ===============================
# LOAD DATA
# ===============================
train = pd.read_csv('Train.csv')
test = pd.read_csv('Test.csv')

train['bank_account'] = train['bank_account'].map({'Yes': 1, 'No': 0})

# ===============================
# CLEAN + FEATURES
# ===============================
def clean_data(df):
    df = df.copy()
    df['age_of_respondent'] = np.clip(df['age_of_respondent'], 16, 90)
    return df

def create_features(df):
    df = df.copy()

    df['is_stable'] = ((df['marital_status'] == 'Married/Living together') &
                       (df['relationship_with_head'] == 'Head of Household')).astype(int)

    df['edu_job_interaction'] = df['education_level'].astype(str) + "_" + df['job_type'].astype(str)

    df['household_pressure'] = df['household_size'] / (df['age_of_respondent'] + 1)

    edu_map = {'No formal education': 0, 'Primary education': 1, 'Secondary education': 2,
               'Vocational/Specialised training': 3, 'Tertiary education': 4,
               'Other/Dont know/RTA': 1}

    df['edu_score'] = df['education_level'].map(edu_map).fillna(1)

    return df

train = clean_data(train)
test = clean_data(test)

features = [c for c in train.columns if c not in ['uniqueid', 'bank_account']]

X = train[features]
y = train['bank_account']
X_test = test[features]

cat_cols = ['country', 'location_type', 'cellphone_access', 'gender_of_respondent',
            'relationship_with_head', 'marital_status', 'education_level', 'job_type']

# ===============================
# OPTUNA (LIGHTGBM)
# ===============================
def objective(trial):

    params = {
        "n_estimators": 800,
        "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.1),
        "num_leaves": trial.suggest_int("num_leaves", 20, 100),
        "max_depth": trial.suggest_int("max_depth", 3, 10),
        "min_child_samples": trial.suggest_int("min_child_samples", 10, 100),
        "subsample": trial.suggest_float("subsample", 0.6, 1.0),
        "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
        "reg_alpha": trial.suggest_float("reg_alpha", 0.0, 1.0),
        "reg_lambda": trial.suggest_float("reg_lambda", 0.0, 1.0)
    }

    skf = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)
    scores = []

    for tr_idx, val_idx in skf.split(X, y):
        X_tr, X_val = X.iloc[tr_idx].copy(), X.iloc[val_idx].copy()
        y_tr, y_val = y.iloc[tr_idx], y.iloc[val_idx]

        for col in ['education_level', 'job_type']:
            mode_map = X_tr.groupby('country')[col].agg(lambda x: x.mode()[0] if not x.mode().empty else 'Unknown')
            X_tr[col] = X_tr[col].fillna(X_tr['country'].map(mode_map))
            X_val[col] = X_val[col].fillna(X_val['country'].map(mode_map))

        X_tr = create_features(X_tr)
        X_val = create_features(X_val)

        for col in cat_cols + ['edu_job_interaction']:
            X_tr[col] = X_tr[col].astype('category')
            X_val[col] = X_val[col].astype('category')

        model = LGBMClassifier(**params)
        model.fit(X_tr, y_tr)

        preds = model.predict_proba(X_val)[:, 1]
        scores.append(mean_absolute_error(y_val, (preds > 0.5).astype(int)))

    return np.mean(scores)

study = optuna.create_study(direction="minimize")
study.optimize(objective, n_trials=20)

best_params = study.best_params
print("Best Params:", best_params)

# ===============================
# MAIN CV
# ===============================
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

oof_preds = np.zeros(len(X))
test_preds = np.zeros(len(X_test))

for fold, (tr_idx, val_idx) in enumerate(skf.split(X, y)):
    print(f"Fold {fold+1}")

    X_tr, X_val = X.iloc[tr_idx].copy(), X.iloc[val_idx].copy()
    y_tr, y_val = y.iloc[tr_idx], y.iloc[val_idx]

    for col in ['education_level', 'job_type']:
        mode_map = X_tr.groupby('country')[col].agg(lambda x: x.mode()[0] if not x.mode().empty else 'Unknown')
        X_tr[col] = X_tr[col].fillna(X_tr['country'].map(mode_map))
        X_val[col] = X_val[col].fillna(X_val['country'].map(mode_map))
        X_test[col] = X_test[col].fillna(X_test['country'].map(mode_map))

    X_tr = create_features(X_tr)
    X_val = create_features(X_val)
    X_test_fold = create_features(X_test.copy())

    for col in cat_cols + ['edu_job_interaction']:
        X_tr[col] = X_tr[col].astype('category')
        X_val[col] = X_val[col].astype('category')
        X_test_fold[col] = X_test_fold[col].astype('category')

    # get categorical indices
    cat_feature_indices = [X_tr.columns.get_loc(col) for col in cat_cols + ['edu_job_interaction']]

    cat = CatBoostClassifier(
        iterations=1000,
        learning_rate=0.03,
        depth=6,
        cat_features=cat_feature_indices,
        verbose=False
    )

    xgb = XGBClassifier(
        n_estimators=1000,
        learning_rate=0.03,
        max_depth=5,
        enable_categorical=True,
        eval_metric='logloss'
    )

    lgb = LGBMClassifier(
        n_estimators=1000,
        **best_params
    )

    # TRAIN
    cat.fit(X_tr, y_tr, eval_set=(X_val, y_val), verbose=False)
    xgb.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], verbose=False)
    lgb.fit(X_tr, y_tr)

    # PRED
    val_cat = cat.predict_proba(X_val)[:, 1]
    val_xgb = xgb.predict_proba(X_val)[:, 1]
    val_lgb = lgb.predict_proba(X_val)[:, 1]

    test_cat = cat.predict_proba(X_test_fold)[:, 1]
    test_xgb = xgb.predict_proba(X_test_fold)[:, 1]
    test_lgb = lgb.predict_proba(X_test_fold)[:, 1]

    stack_X = np.vstack([val_cat, val_xgb, val_lgb]).T
    stack_test = np.vstack([test_cat, test_xgb, test_lgb]).T

    meta = LogisticRegression()
    meta.fit(stack_X, y_val)

    oof_preds[val_idx] = meta.predict_proba(stack_X)[:, 1]
    test_preds += meta.predict_proba(stack_test)[:, 1] / skf.n_splits

# ===============================
# THRESHOLD
# ===============================
best_t = 0.5
best_mae = 1

for t in np.linspace(0.1, 0.9, 50):
    mae = mean_absolute_error(y, (oof_preds > t).astype(int))
    if mae < best_mae:
        best_mae = mae
        best_t = t

print("Final MAE:", best_mae)

# ===============================
# SUBMISSION
# ===============================
submission = pd.DataFrame({
    'unique_id': test['uniqueid'].astype(str) + ' x ' + test['country'].astype(str),
    'bank_account': (test_preds > best_t).astype(int)
})

submission.to_csv("final_submission.csv", index=False)
print(" DONE")
